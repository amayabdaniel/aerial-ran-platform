# Template for infra/k8s/platform/secrets.env — the REAL file is gitignored.
# Generate real, random credentials with:  make k8s-secrets   (scripts/gen-secrets.sh)
# NEVER put real secret values in this committed example.
#
# The kustomize secretGenerator in kustomization.yaml reads the real secrets.env
# and produces the `aerial-secrets` Secret. Format is dotenv (KEY=VALUE, no quotes).
POSTGRES_PASSWORD=CHANGE_ME_generate_with_make_k8s_secrets
JWT_SECRET=CHANGE_ME_min_32_chars_generate_with_make_k8s_secrets
DATABASE_URL_IAM=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=iam
DATABASE_URL_SUBSCRIBER=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=subscriber
DATABASE_URL_ESIM=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=esim
DATABASE_URL_PROVISION=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=provision
DATABASE_URL_RANCTL=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=ranctl
DATABASE_URL_BILLING=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=billing
DATABASE_URL_MESSAGING=postgres://aerial_admin:CHANGE_ME@postgres.aerial.svc.cluster.local:5432/aerial?sslmode=disable&search_path=messaging
